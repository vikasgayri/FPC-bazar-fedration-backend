# Copy to .env and fill in. Never commit .env.

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Database name at the end.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/fpcbazaar?retryWrites=true&w=majority

# Long random secret for login tokens (min 32 chars). Generate: openssl rand -base64 48
JWT_SECRET=
JWT_TTL=12h

# Frontend address(es), comma separated
CORS_ORIGINS=http://localhost:5173

# First admin login, created only if no admin exists yet (password min 10 chars).
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME="Federation Admin"
# true for ONE start when nobody can sign in (e.g. the admin email is lost): ADMIN_USERNAME becomes an active
# admin with ADMIN_PASSWORD. Set back to false right after, or the password is reset at every start.
ADMIN_RECOVER=false

# Uploaded documents are saved here on the server (Infinitive Cloud disk)
STORAGE_DIR=./data/uploads

# Public address of this API (used for vendor logo links)
PUBLIC_BASE_URL=http://localhost:8080
PORT=8080

# true only on your laptop: creates demo logins admin/admin123, rajasthan-head/state123,
# project-head/project123, vendor/vendor123, fpo/fpo123. NEVER true on the live server.
SEED_DEMO=false

# Every sign-in: password, then a 6-digit code emailed to the login (needs working email below).
# false ONLY for local testing without email. Never false on the live server.
LOGIN_OTP=true

# Email uses Brevo HTTPS API, not SMTP. Generate a separate encryption key:
# openssl rand -base64 32 (retain this key when restoring queued email)
MAIL_ENABLED=false
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME="FPC Bazaar Federation"
MAIL_ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:5173
MAIL_SANDBOX=false
MAIL_MAX_ATTEMPTS=8
PASSWORD_RESET_TTL=15m
BIND_ADDRESS=127.0.0.1

# Optional backups (absolute paths). Offsite copy is encrypted by restic.
# BACKUP_DIR=/var/backups/fpc-bazaar
# Local backups older than this many days are deleted after each successful backup (newest 3 are always kept).
# BACKUP_KEEP_DAYS=14
# RESTIC_REPOSITORY=s3:https://YOUR-S3-ENDPOINT/YOUR-BUCKET/fpc-bazaar
# RESTIC_PASSWORD_FILE=/etc/fpc-bazaar/restic-password
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Local runner: true validates email without delivery; false sends real email.
LOCAL_MAIL_SANDBOX=true
