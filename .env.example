# Copy to .env and fill in. Never commit .env.

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Database name at the end.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/fpcbazaar?retryWrites=true&w=majority

# Long random secret for login tokens (min 32 chars). Generate: openssl rand -base64 48
JWT_SECRET=
JWT_TTL=12h

# Frontend address(es), comma separated
CORS_ORIGINS=http://localhost:5173

# First admin login, created only if no admin exists yet (password min 10 chars).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Federation Admin

# Uploaded documents are saved here on the server (Infinitive Cloud disk)
STORAGE_DIR=./data/uploads

# Public address of this API (used for vendor logo links)
PUBLIC_BASE_URL=http://localhost:8080
PORT=8080

# true only on your laptop: creates demo logins admin/admin123, rajasthan-head/state123,
# project-head/project123, vendor/vendor123, fpo/fpo123. NEVER true on the live server.
SEED_DEMO=false
